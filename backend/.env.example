# =============================================================================
# AI Disaster Management System - Environment Variables Template
# -----------------------------------------------------------------------------
# 1) Copy this file to ".env" in the directory you run the backend from:
#       cp .env.example .env
# 2) Fill in your real values. NEVER commit the .env file (it is gitignored).
# 3) The backend reads this file automatically at startup (Spring Boot
#    "spring.config.import=optional:file:.env[.properties]").
#    Real process environment variables always override values in .env.
# 4) Every variable below is OPTIONAL unless marked MANDATORY. Leaving an
#    optional key blank simply disables that external service and the app
#    falls back to its built-in mock/offline provider.
# =============================================================================

# ============================== WEATHER =====================================
# OpenWeatherMap (current weather). Blank => mock weather data provider.
OPENWEATHER_API_KEY=
# OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# ============================== AI PROVIDERS ================================
# Google Gemini (future AI engine provider). Blank => local AI engine.
GOOGLE_GEMINI_API_KEY=
# Groq (future AI engine provider). Blank => local AI engine.
GROQ_API_KEY=

# ============================== ROUTING =====================================
# OpenRouteService Directions API key. Blank => Haversine offline fallback.
OPENROUTESERVICE_API_KEY=
# Request timeout in milliseconds (connect + read).
OPENROUTESERVICE_TIMEOUT_MS=8000
# Number of retries after a failed/timeout request before falling back to Haversine.
OPENROUTESERVICE_RETRY_COUNT=2
# Google Maps Directions API key (optional, provider is a stub today).
GOOGLE_MAPS_API_KEY=
# Mapbox Directions access token (optional, provider is a stub today).
MAPBOX_ACCESS_TOKEN=
# Routing provider to activate: openrouteservice | google | mapbox | haversine
ROUTING_PROVIDER=openrouteservice

# ============================== NOTIFICATIONS ===============================
# Firebase Cloud Messaging server key (future push notifications).
FIREBASE_SERVER_KEY=
# Brevo (Sendinblue) transactional email API key (future email delivery).
BREVO_API_KEY=
# Twilio SMS credentials (future real SMS; blank => mock SMS provider).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================== HAZARD DATA =================================
# OpenAQ air quality API key (future air-quality feed).
OPENAQ_API_KEY=
# USGS Earthquake API base URL (public, usually no key needed).
USGS_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
# USGS live earthquake GeoJSON feed (drives the live earthquake map layer).
USGS_EARTHQUAKE_API=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
# Earthquake feed refresh interval in milliseconds (default: 5 minutes).
EARTHQUAKE_REFRESH_INTERVAL_MS=300000
# How long a successful USGS fetch is cached, in minutes.
EARTHQUAKE_CACHE_MINUTES=5
# NASA FIRMS (fire/thermal anomalies) API key (drives the live wildfire feed).
# Blank key = empty result set (never crashes).
NASA_FIRMS_API_KEY=
# FIRMS area CSV endpoint base URL.
# NASA_FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
# FIRMS refresh interval in milliseconds (default: 10 minutes).
FIRE_REFRESH_INTERVAL_MS=600000
# How long a successful FIRMS fetch is cached, in minutes.
FIRE_CACHE_MINUTES=10
# Comma-separated FIRMS datasets to poll (VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, VIIRS_NOAA21_NRT, MODIS_NRT).
NASA_FIRMS_SOURCES=VIIRS_SNPP_NRT,MODIS_NRT
# FIRMS area-query window (days back / window width in days).
NASA_FIRMS_DAY=1
NASA_FIRMS_DAY_RANGE=1
# NASA EONET natural-disaster event feed (drives the live map event layer).
# Public feed; no API key required. Blank url = empty result set (never crashes).
NASA_EONET_API=https://eonet.gsfc.nasa.gov/api/v3/events
# EONET refresh interval in milliseconds (default: 10 minutes).
EONET_REFRESH_INTERVAL_MS=600000
# How long a successful EONET fetch is cached, in minutes.
EONET_CACHE_MINUTES=10

# ============================== DATABASE ====================================
# Default profile uses an in-memory H2 database and needs no credentials.
# Activate the "postgres" profile (SPRING_PROFILES_ACTIVE=postgres) to use
# PostgreSQL. Either set DATABASE_URL, or the individual DB_* variables.
# MANDATORY (postgres profile): DATABASE_URL or (DB_HOST/DB_PORT/DB_NAME).
DATABASE_URL=
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=disaster_db

# ============================== JWT / SECURITY ==============================
# MANDATORY in production (postgres profile): a JWT_SECRET of at least 32
# bytes. The default profile ships a demo secret so the app can start locally.
# Generate one with:
#   openssl rand -base64 64
JWT_SECRET=
# Optional: separate refresh-token secret for future refresh-token flow.
JWT_REFRESH_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_MAX_PER_MINUTE=60
RATE_LIMIT_PUBLIC_MAX_PER_MINUTE=20

# ============================== MAIL ========================================
# SMTP credentials for real email (blank => mock email provider).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ============================== EMAIL (RESEND) ==============================
# Resend transactional email API (https://resend.com).
#   - Set RESEND_API_KEY to enable real email delivery through the Resend
#     REST API (professional HTML templates, retries, multi-recipient support).
#   - Leave RESEND_API_KEY blank to keep the built-in mock email provider
#     (logs the message instead of sending). The app never crashes either way.
#   - RESEND_FROM_EMAIL must be a verified sender/domain in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
# Optional Resend tuning (defaults shown):
# RESEND_API_URL=https://api.resend.com/emails
# RESEND_TIMEOUT_MS=8000
# RESEND_RETRY_COUNT=2
# RESEND_RETRY_BACKOFF_MS=500
# Emergency contact number shown in every branded email template.
EMAIL_EMERGENCY_CONTACT=112

# ============================== APP =========================================
# Frontend URL used for CORS / links.
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
